{
  "name": "arc-borrow-lend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Lending and borrowing demo on Arc Testnet — deposit cirBTC as collateral and borrow USDC",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.hardhat.json",
    "compile": "hardhat compile",
    "deploy:lending": "hardhat run scripts/deploy-lending.ts --network arcTestnet",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:status": "supabase status",
    "test": "vitest run",
    "test:contracts": "hardhat test nodejs",
    "test:integration": "vitest run --config vitest.integration.config.mts"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@circle-fin/modular-wallets-core": "^1.0.16",
    "@openzeppelin/contracts": "^5.6.1",
    "@supabase/supabase-js": "^2.119.0",
    "@tanstack/react-query": "^5.108.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.74.0",
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "viem": "^2.58.0",
    "wagmi": "^3.7.11"
  },
  "overrides": {
    "viem": "$viem",
    "@ts-morph/common": {
      "minimatch": "^11.0.9"
    },
    "web3-validator": {
      "zod": "^4.6.6"
    }
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-ethers": "^4.2.2",
    "@nomicfoundation/hardhat-node-test-runner": "^3.1.2",
    "@nomicfoundation/hardhat-verify": "^3.1.5",
    "@tailwindcss/postcss": "^4.3.5",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "dotenv": "^18.0.10",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.4.6",
    "ethers": "^6.17.0",
    "hardhat": "^3.22.0",
    "shadcn": "^4.23.0",
    "supabase": "^3.2.0",
    "tailwindcss": "^4.3.5",
    "typescript": "^6.0.3",
    "vitest": "^5.1.0"
  }
}
